# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Large / backup archives & binaries
*.zip
*.tar.gz
*.apk
*.rar
apk/


# Runtime output logs & data
output/
data/output/*
!data/output/.gitkeep

# Sensitive tokens & proxies (prevent leaking credentials)
humanizer/input/tokens.txt
data/1m.txt
data/3m.txt
data/proxies.txt
data/keys/
data/used_tokens.txt
data/used_1m.txt
data/used_3m.txt
data/balances.json
data/invoices.json


# Virtual environments & IDEs
.venv/
venv/
env/
.vscode/
.idea/

# Windows system files
desktop.ini
Thumbs.db

